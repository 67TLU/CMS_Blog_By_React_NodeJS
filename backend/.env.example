# ========================================
# SERVER
# ========================================
NODE_ENV=development
PORT=4000

# ========================================
# FRONTEND
# ========================================
FRONTEND_URL=http://localhost:5173

# ========================================
# MYSQL DATABASE
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=portal_news

# ========================================
# JWT AUTHENTICATION
# ========================================
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_token
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_for_refresh_token
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# COOKIE
# ========================================
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# ========================================
# PASSWORD RESET EMAIL (configure at least one SMTP method)
# ========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=Portal News <no-reply@example.com>
# Alternative: SMTP_URL=smtps://user:password@smtp.example.com:465

# ========================================
# GOOGLE OAUTH 2.0
# ========================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Public origin for generated upload URLs (optional; empty uses relative /Uploads/...)
PUBLIC_BASE_URL=http://localhost:4000
